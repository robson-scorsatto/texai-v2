# Copy to .env.local for local development.

NODE_ENV=development

# "pglite://<path>" for local/dev (embedded, file-backed, no server needed)
# or a real "postgres://user:pass@host:port/db" for staging/production.
DATABASE_URL=pglite://./.data/texai-dev

# Long random string in production. A dev fallback is used automatically
# if this is unset in development — see src/config/env.ts.
SESSION_SECRET=change-me-to-a-long-random-value

# Master private-beta switch — enforced on the backend, never the frontend.
PRIVATE_BETA=true

APP_URL=http://localhost:3000

# Used ONLY by `npm run db:seed` to create the first platform
# administrator. Never commit real values — set them in your local
# .env.local or in your deploy platform's secret manager.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador TEXAI

# 32 raw bytes, base64-encoded — encrypts WhatsApp/Stripe credentials
# saved via /admin at rest. Generate with: openssl rand -base64 32
# A dev fallback is used automatically if unset — see src/config/env.ts.
# MUST be set to a real generated value in production.
INTEGRATIONS_ENCRYPTION_KEY=
